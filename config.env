# ===== zundamon-speak 設定 =====
# 変更したら各トリガーは自動で次回発話時に反映(常駐デーモンは再起動で確実)。

# --- VOICEVOX エンジン ---
VOICEVOX_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER=3        # 3 = ずんだもん(ノーマル)。1=四国めたん 等
VOICEVOX_SPEED=1.1        # 話速 (1.0=標準)
VOICEVOX_PITCH=0.0        # 音高
VOICEVOX_VOLUME=1.0       # 音量

# --- 発話のふるまい ---
ENABLE_CACHE=1           # 合成済み WAV を再利用(同じ台詞は即再生・エンジン不要)
FALLBACK_SAY=0           # 1=エンジン未起動時に macOS say で代替(ずんだもん声では無い)
QUIET_START=23           # 静音開始(時, 0-23)。-1 で静音無効
QUIET_END=8              # 静音終了(時)。23-8 なら 23時〜翌8時は黙る
SPEAK_LOCK_TIMEOUT=8     # 発話の順番待ち上限(秒)。超えたら捨てる(喋り続け防止)
DEDUPE_SEC=4             # 同一テキストの連続抑制(秒)
SPEAK_MAXLEN=140         # 長文の安全打ち切り(文字)

# --- 読み(ローマ字の名前を綴り読みさせない) ---
# 1=ローマ字の日本語名を かな読み に変換(Ayaka→あやか, Yuki→ゆき)。
# 英単語(Slack/GitHub 等)や全大文字の頭字語(NHK/API)は変換せず元のまま。
ROMAJI_TO_KANA=1
# 自動変換が外す/間違える語の読みを手動指定(セミコロン区切り, 左=元 右=読み)。
# 例: READING_MAP=Zoom=ズーム;Ayaka=あやか;API=エーピーアイ
READING_MAP=

# --- 通知トリガー (switches/notify) ---
NOTIFY_POLL_SEC=3        # 通知DBのポーリング間隔(秒)
NOTIFY_READ_BODY=0       # 0=アプリ名+タイトルのみ(プライバシー優先) 1=本文も読む
NOTIFY_MAXLEN=70         # 通知読み上げの最大文字数
# 読み上げをスキップするアプリ(バンドルID か アプリ名の部分一致, カンマ区切り)
# 既定で 2FA/パスワード/銀行系など漏れたら困るものは抑制推奨。
# 通話系(facetime/電話)は iPhone で FaceTime/通話中に Continuity 経由で
# 着信リング・状態更新のたびに通知DBへレコードが連発挿入され、ずんだもんが
# 「フェイスタイムから通知なのだ」を喋りまくるため既定で抑制する。
# (iPhone が手元にあれば Mac 側の通話通知は不要、という方針)
NOTIFY_DENY=com.apple.Passwords,1Password,Authenticator,com.apple.Keychain,com.apple.facetime,com.apple.mobilephone,com.apple.TelephonyUtilities,com.apple.callservicesd,com.apple.CallHistoryPluginHelper
# このリストにアプリがある時だけ読む(空なら全アプリ対象。DENY が優先)
NOTIFY_ALLOW=

# --- 時刻トリガー (switches/time) ---
TIME_HOURLY=1            # 1=毎時 0 分に時報
TIME_BREAK_MIN=0         # 休憩リマインド間隔(分)。0=無効。例 50 でポモドーロ風

# --- 電源/システムトリガー (switches/power) ---
POWER_WATCH=1            # 1=充電開始/終了・低バッテリーを通知
POWER_LOW_PCT=20         # この%以下で「バッテリー少ない」を一度だけ通知
POWER_POLL_SEC=12        # 電源状態のポーリング間隔(秒)
# 起動を知らせたいアプリ名(部分一致, カンマ区切り)。空なら アプリ起動通知は無効
APP_WATCH=
APP_POLL_SEC=5           # アプリ起動監視のポーリング間隔(秒)
